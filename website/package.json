{
  "name": "modsim-documentation",
  "version": "0.0.0",
  "private": true,
  "description": "ModSim project website and documentation.",
  "packageManager": "npm@10.9.7",
  "engines": {
    "node": ">=22 <23",
    "npm": ">=10 <11"
  },
  "scripts": {
    "docs:generate": "node scripts/generate.mjs",
    "docs:check": "node scripts/generate.mjs --check",
    "docs:api": "node scripts/generate.mjs --api",
    "docs:uml": "node scripts/generate.mjs --uml",
    "predocs:dev": "npm run docs:generate",
    "docs:dev": "docusaurus start --host 127.0.0.1 --no-open",
    "predocs:build": "npm run docs:generate",
    "docs:build": "docusaurus build",
    "docs:serve": "node scripts/serve.mjs",
    "docs:clear": "docusaurus clear",
    "site:check": "node --test scripts/tests/*.test.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@docusaurus/core": "3.10.2",
    "@docusaurus/preset-classic": "3.10.2",
    "@docusaurus/theme-mermaid": "3.10.2",
    "@mdx-js/react": "3.1.1",
    "prism-react-renderer": "2.4.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "serve-handler": "6.1.8"
  },
  "devDependencies": {
    "@docusaurus/module-type-aliases": "3.10.2",
    "@docusaurus/tsconfig": "3.10.2",
    "@docusaurus/types": "3.10.2",
    "@types/react": "19.3.0",
    "typescript": "5.9.3"
  },
  "overrides": {
    "@docusaurus/core": {
      "tinypool": "2.1.2"
    },
    "serialize-javascript": "7.1.3",
    "sockjs": {
      "uuid": "11.1.1"
    }
  },
  "browserslist": {
    "production": [
      ">0.5%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 3 chrome versions",
      "last 3 firefox versions",
      "last 5 safari versions"
    ]
  }
}
